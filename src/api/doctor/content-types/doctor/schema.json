{
  "kind": "collectionType",
  "collectionName": "doctors",
  "info": {
    "singularName": "doctor",
    "pluralName": "doctors",
    "displayName": "Medicos"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "professional_card_number": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "university": {
      "type": "string",
      "required": true
    },
    "years_of_experience": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "veterinarian": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::veterinarian.veterinarian"
    },
    "status_register": {
      "type": "enumeration",
      "required": true,
      "default": "registered",
      "enum": [
        "registered",
        "approved",
        "suspended",
        "review"
      ]
    },
    "days": {
      "type": "component",
      "component": "shared.days",
      "repeatable": true
    },
    "headquarter": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::headquarter.headquarter"
    },
    "document": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "files"
      ]
    }
  }
}
