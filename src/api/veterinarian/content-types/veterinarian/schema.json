{
  "kind": "collectionType",
  "collectionName": "veterinarians",
  "info": {
    "singularName": "veterinarian",
    "pluralName": "veterinarians",
    "displayName": "Veterinaria"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "company_name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "company_name"
    },
    "nit": {
      "type": "biginteger",
      "required": true,
      "unique": true
    },
    "legal_representative": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "string",
      "required": true,
      "regex": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
    },
    "phone": {
      "type": "string",
      "required": true,
      "regex": "^\\+[0-9]{7,15}$"
    },
    "status_vet": {
      "type": "enumeration",
      "required": true,
      "default": "process",
      "enum": [
        "process",
        "success"
      ]
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "document": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    }
  }
}
