{
  "kind": "collectionType",
  "collectionName": "headquarters",
  "info": {
    "singularName": "headquarter",
    "pluralName": "headquarters",
    "displayName": "Sedes"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "veterinarian": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::veterinarian.veterinarian"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "label": {
      "type": "string",
      "required": true
    },
    "location": {
      "type": "customField",
      "customField": "plugin::location-plugin.location"
    },
    "tel": {
      "type": "string",
      "required": true,
      "regex": "^\\+[0-9]{7,15}$"
    },
    "city": {
      "type": "component",
      "component": "shared.city",
      "repeatable": false
    },
    "days": {
      "type": "component",
      "component": "shared.days",
      "repeatable": true
    },
    "services": {
      "type": "component",
      "component": "shared.servicios",
      "repeatable": true
    }
  }
}
